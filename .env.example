# Copy to `.env` (Prisma CLI and the seed read it; Next.js reads it too). Never commit real values.

# PostgreSQL connection. DIRECT_URL is the non-pooled URL used by migrations
# (set it to the same value as DATABASE_URL when you don't use a pooler).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cyberescape?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/cyberescape?schema=public"

# Secret used to derive every challenge flag and to key answer hashes (server-side only).
# Required in production — e.g. `openssl rand -hex 32`. Re-run `npm run db:seed` after changing it.
FLAG_SECRET=""

# Signs the login session cookie. Required in production — e.g. `openssl rand -hex 32`.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# This account is promoted to ADMIN by `npm run db:seed` (register it first, or also set ADMIN_PASSWORD
# so the seed creates it). Players can never make themselves admin.
ADMIN_EMAIL=""
# Optional, only used by the seed to create the admin account when it does not exist yet.
ADMIN_PASSWORD=""
